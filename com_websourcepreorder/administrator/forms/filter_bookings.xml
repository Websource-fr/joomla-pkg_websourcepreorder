<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" />
		<field name="status" type="list" label="COM_WEBSOURCEPREORDER_FILTER_STATUS" onchange="this.form.submit();">
			<option value="">COM_WEBSOURCEPREORDER_FILTER_STATUS_ALL</option>
			<option value="0">COM_WEBSOURCEPREORDER_BSTATUS_0</option>
			<option value="1">COM_WEBSOURCEPREORDER_BSTATUS_1</option>
			<option value="2">COM_WEBSOURCEPREORDER_BSTATUS_2</option>
		</field>
		<field name="rule_id" type="sql" label="COM_WEBSOURCEPREORDER_FILTER_RULE" query="SELECT id AS value, CONCAT('#', id) AS rule_id FROM #__websourcepreorder_rules ORDER BY id DESC" key_field="value" value_field="rule_id" onchange="this.form.submit();">
			<option value="">COM_WEBSOURCEPREORDER_FILTER_RULE_ALL</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.id DESC" onchange="this.form.submit();">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.release_date ASC">COM_WEBSOURCEPREORDER_SORT_RELEASE_ASC</option>
		</field>
		<field name="limit" type="limitbox" class="input-mini" default="25" onchange="this.form.submit();" />
	</fields>
</form>
