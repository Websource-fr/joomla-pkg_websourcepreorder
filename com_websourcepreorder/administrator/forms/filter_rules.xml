<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" />
		<field name="state" type="list" label="COM_WEBSOURCEPREORDER_FILTER_STATE" onchange="this.form.submit();">
			<option value="">COM_WEBSOURCEPREORDER_FILTER_STATE_ALL</option>
			<option value="0">COM_WEBSOURCEPREORDER_STATE_0</option>
			<option value="1">COM_WEBSOURCEPREORDER_STATE_1</option>
			<option value="2">COM_WEBSOURCEPREORDER_STATE_2</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.date_release ASC" onchange="this.form.submit();">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.date_release ASC">COM_WEBSOURCEPREORDER_SORT_RELEASE_ASC</option>
			<option value="a.date_release DESC">COM_WEBSOURCEPREORDER_SORT_RELEASE_DESC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
		</field>
		<field name="limit" type="limitbox" class="input-mini" default="25" onchange="this.form.submit();" />
	</fields>
</form>
